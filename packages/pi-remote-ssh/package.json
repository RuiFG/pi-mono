{
  "name": "pi-remote-ssh",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-host SSH and SFTP tools with interactive host management for Pi.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": ">=22.19.0" },
  "keywords": ["pi-package", "ssh", "sftp"],
  "repository": { "type": "git", "url": "https://github.com/RuiFG/pi-mono.git", "directory": "packages/pi-remote-ssh" },
  "pi": { "extensions": ["./index.ts"] },
  "files": ["index.ts", "src", "README.md", "NOTICE.md"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx test/run-integration.ts",
    "test:package": "tsx test/package-smoke.ts",
    "test:sdk": "tsx test/sdk-smoke.ts",
    "test:native-tui": "python3 test/native-tui.py",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": { "minimatch": "^10.2.6", "proper-lockfile": "^4.1.2", "ssh2": "^1.17.0", "zod": "^4.6.7" },
  "optionalDependencies": { "@napi-rs/keyring": "^2.1.2" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*", "typebox": "*" },
  "devDependencies": { "@earendil-works/pi-coding-agent": "1.3.0", "@earendil-works/pi-tui": "1.3.0", "typebox": "^1.0.0", "@types/node": "^24.0.0", "@types/ssh2": "^1.15.6", "@types/proper-lockfile": "^4.1.4", "tsx": "^4.23.15", "typescript": "^7.0.2" }
}
